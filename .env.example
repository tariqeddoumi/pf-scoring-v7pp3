# ==========================================
# DATABASE & SUPABASE
# ==========================================
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_anon_...
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_...

# ==========================================
# AUTHENTICATION & JWT
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-change-in-production
NODE_ENV=development

# ==========================================
# APPLICATION
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# DEPLOYMENT
# ==========================================
VERCEL_ENV=preview

# ==========================================
# OPTIONAL: Email Service
# ==========================================
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-email
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@yourapp.com

# ==========================================
# OPTIONAL: Logging & Monitoring
# ==========================================
# LOG_LEVEL=info
# SENTRY_DSN=https://...@sentry.io/...

# ==========================================
# OPTIONAL: Integration Tokens
# ==========================================
# NOTION_API_KEY=your-notion-api-key
# INIT_TOKEN=your-init-secret-token
