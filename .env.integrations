# Email Service (SendGrid, Mailgun, SMTP)
# EMAIL_PROVIDER=sendgrid|mailgun|smtp
# EMAIL_API_KEY=your-api-key
# EMAIL_FROM=noreply@pfscoring.ma

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_URL=https://your-domain.vercel.app/api/webhooks

# Supabase Webhooks
# Setup in Supabase Dashboard → Database → Webhooks
# - evaluations table: INSERT, UPDATE events
# - alerts table: INSERT events
# - comments table: INSERT events

# PDF Generation
# PDF_SERVICE=native|puppeteer|html2pdf
# Can use print dialog (Ctrl+P) or server-side generation

# Notifications
# ENABLE_EMAIL_NOTIFICATIONS=true
# ENABLE_SMS_NOTIFICATIONS=false (future)
# ENABLE_PUSH_NOTIFICATIONS=false (future)
