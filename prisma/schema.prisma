generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
  REVIEWER
  RISK
  COMMITTEE
  VIEWER
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  COMMITTEE_PENDING
  COMMITTEE_APPROVED
  COMMITTEE_REJECTED
}

enum DecisionAction {
  SUBMIT
  RETURN_TO_ANALYST
  RECOMMEND_APPROVAL
  RECOMMEND_REJECTION
  APPROVE
  REJECT
  COMMITTEE_APPROVE
  COMMITTEE_REJECT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

enum RuleSeverity {
  INFO
  RED_FLAG
  NO_GO
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  fullName        String
  passwordHash    String
  role            UserRole
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdProjects Project[]            @relation("ProjectCreatedBy")
  evaluations     Evaluation[]         @relation("EvaluationCreatedBy")
  notifications   Notification[]
  decisions       EvaluationDecision[] @relation("DecisionByUser")
  auditEntries    AuditLog[]           @relation("AuditByUser")
}

model Project {
  id               String       @id @default(cuid())
  projectCode      String       @unique
  sponsorName      String
  projectName      String
  country          String
  city             String?
  sector           String
  phase            String
  totalCostMad     Decimal      @db.Decimal(18, 2)
  requestedDebtMad Decimal      @db.Decimal(18, 2)
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        User         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  evaluations      Evaluation[]
}

model Evaluation {
  id                 String                  @id @default(cuid())
  reference          String                  @unique
  projectId          String
  modelVersion       String                  @default("V7++.3")
  createdById        String
  status             EvaluationStatus        @default(DRAFT)
  phase              String
  requestedAmountMad Decimal                 @db.Decimal(18, 2)
  finalScore         Decimal?                @db.Decimal(8, 2)
  finalGrade         String?
  bamClass           String?
  hardStop           Boolean                 @default(false)
  hardStopReason     String?
  summaryJson        Json?
  inputJson          Json
  submittedAt        DateTime?
  approvedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  project            Project                 @relation(fields: [projectId], references: [id])
  createdBy          User                    @relation("EvaluationCreatedBy", fields: [createdById], references: [id])
  domainScores       EvaluationDomainScore[]
  decisions          EvaluationDecision[]
  auditLogs          AuditLog[]
}

model EvaluationDomainScore {
  id            String     @id @default(cuid())
  evaluationId  String
  domainCode    String
  domainName    String
  weight        Decimal    @db.Decimal(8, 4)
  rawScore      Decimal    @db.Decimal(8, 2)
  weightedScore Decimal    @db.Decimal(8, 2)
  detailsJson   Json?
  evaluation    Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

model EvaluationDecision {
  id                String         @id @default(cuid())
  evaluationId      String
  actorUserId       String
  action            DecisionAction
  levelCode         String
  levelLabel        String
  comment           String?
  delegatedLimitMad Decimal?       @db.Decimal(18, 2)
  createdAt         DateTime       @default(now())
  evaluation        Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  actor             User           @relation("DecisionByUser", fields: [actorUserId], references: [id])
}

model DelegationMatrix {
  id                String    @id @default(cuid())
  levelCode         String    @unique
  levelLabel        String
  role              UserRole
  minAmountMad      Decimal   @db.Decimal(18, 2)
  maxAmountMad      Decimal   @db.Decimal(18, 2)
  minScoreInclusive Decimal?  @db.Decimal(8, 2)
  maxScoreExclusive Decimal?  @db.Decimal(8, 2)
  allowedSectors    String?
  allowedPhases     String?
  canApprove        Boolean   @default(false)
  canRecommend      Boolean   @default(true)
  isCommittee       Boolean   @default(false)
  priority          Int       @default(100)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ScoreDomain {
  id           String           @id @default(cuid())
  code         String           @unique
  label        String
  description  String?
  weightDev    Decimal          @db.Decimal(8, 4)
  weightConstr Decimal          @db.Decimal(8, 4)
  weightOps    Decimal          @db.Decimal(8, 4)
  displayOrder Int              @default(100)
  isActive     Boolean          @default(true)
  criteria     ScoreCriterion[]
}

model ScoreCriterion {
  id              String        @id @default(cuid())
  domainId        String
  code            String        @unique
  label           String
  inputType       String
  weight          Decimal       @db.Decimal(8, 4)
  hardStopIfBelow Decimal?      @db.Decimal(8, 2)
  displayOrder    Int           @default(100)
  isActive        Boolean       @default(true)
  domain          ScoreDomain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  options         ScoreOption[]
  ranges          ScoreRange[]
}

model ScoreOption {
  id          String         @id @default(cuid())
  criterionId String
  valueCode   String
  label       String
  score       Decimal        @db.Decimal(8, 2)
  displayOrder Int           @default(100)
  isRedFlag   Boolean        @default(false)
  criterion   ScoreCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
}

model ScoreRange {
  id           String         @id @default(cuid())
  criterionId  String
  minInclusive Decimal        @db.Decimal(18, 4)
  maxExclusive Decimal        @db.Decimal(18, 4)
  score        Decimal        @db.Decimal(8, 2)
  label        String?
  criterion    ScoreCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  title     String
  message   String
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  sentAt    DateTime?
  metaJson  Json?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String      @id @default(cuid())
  evaluationId String?
  actorUserId  String?
  entityName   String
  entityId     String
  fieldName    String
  oldValue     String?
  newValue     String?
  action       String
  createdAt    DateTime    @default(now())
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  actor        User?       @relation("AuditByUser", fields: [actorUserId], references: [id])
}

model RuleSet {
  id          String      @id @default(cuid())
  code        String      @unique
  label       String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  rules       NoGoRule[]
}

model NoGoRule {
  id            String       @id @default(cuid())
  ruleSetId     String?
  code          String       @unique
  title         String
  scope         String?
  severity      RuleSeverity
  expression    String
  outcome       String
  committeeFlag Boolean      @default(false)
  displayOrder  Int          @default(100)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  ruleSet       RuleSet?     @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)
}

model CommitteeTemplate {
  id             String   @id @default(cuid())
  code           String   @unique
  label          String
  headerTitle    String
  subTitle       String?
  footerText     String?
  primaryColor   String   @default("#0F172A")
  accentColor    String   @default("#1D4ED8")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
