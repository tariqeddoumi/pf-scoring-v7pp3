// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL") // Optional for production/serverless
}

// ============================================================================
// EXISTING MODELS (PRESERVED FOR BACKWARD COMPATIBILITY)
// ============================================================================

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String?
  nom             String
  prenom          String
  role            UserRole @default(analyst)
  oauthProvider   String?
  oauthId         String?
  avatar          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectsCreated Project[]
  auditLogs       AuditLog[]
  evaluations     Evaluation[]        @relation("AnalystEvaluations")
  scoringAudits   ScoringAuditLog[]   @relation("ScoringAuditLogs")

  // New relationships for scoring governance
  modelsOwned     ScoringModel[]      @relation("OwnerBusiness")
  versionsCreated ScoringModelVersion[] @relation("CreatedBy")
  versionsValidated ScoringModelVersion[] @relation("ValidatedBy")
  versionsPublished ScoringModelVersion[] @relation("PublishedBy")
  scoringEvaluations ScoringEvaluation[] @relation("ScoringAnalyst")
  changeLogs      ScoringChangeLog[]  @relation("ChangedBy")

  @@map("__TABLE_PREFIX___users")
}

model Client {
  id                      String    @id @default(uuid())
  nom                     String
  email                   String?   @unique
  telephone               String?
  secteur                 String?
  pays                    String?
  type                    String?   @default("Entreprise")
  description             String?
  status                  String    @default("Actif")
  // Extended fields
  raisonSociale           String?
  nomCommercial           String?
  typeClient              String?   @default("Entreprise")
  formeJuridique          String?
  segmentClientele        String?
  ratingInterne           String?
  statutBancaire          String?   @default("Prospect")
  statusKYC               String?   @default("En attente")
  statusConformite        String?   @default("En attente")
  effectifs               Int?
  capitalSocial           Float?
  chiffreAffaires         Float?
  adresse                 String?
  codePostal              String?
  ville                   String?
  website                 String?
  centreAffaires          String?
  gestionnaire            String?
  dateRelation            DateTime?
  exposition              Float?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relationships used by project finance scoring and dynamic data bindings
  projects                Project[]
  scoringEvaluations      ScoringEvaluation[]

  @@map("__TABLE_PREFIX___clients")
}

model Project {
  id                          String        @id @default(uuid())
  nom                         String
  description                 String
  secteur                     String
  montant                     Float
  devise                      String        @default("MAD")
  status                      ProjectStatus @default(brouillon)
  scoreGlobal                 Float?
  grade                       String?
  creePar                     String        @db.Uuid
  countryCode                 String?
  clientId                    String?
  dateCreation                DateTime      @default(now())
  dateMiseAJour               DateTime      @updatedAt
  // Extended fields
  sponsorPrincipal            String?
  nomSPV                      String?
  constructeurEPC             String?
  operateurOM                 String?
  technologie                 String?
  capaciteInstallee           Float?
  debutConstruction           DateTime?
  finConstruction             DateTime?
  coutTotal                   Float?
  financement                 Float?
  apportPropre                Float?
  structureCapitalePrincipale String?
  dureeCredit                 Int?
  taux                        Float?
  typeCredit                  String?
  dureeProjet                 Int?
  periodeAmorce               Int?
  periodeRemboursement        Int?
  tauxCouverture              Float?
  ratio                       Float?

  user                        User       @relation(fields: [creePar], references: [id], onDelete: Cascade)
  client                      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  scorings                    Scoring[]
  auditLogs                   AuditLog[]
  evaluations                 Evaluation[]  @relation("ProjectEvaluations")

  // New relationships for scoring
  scoringEvaluations          ScoringEvaluation[] @relation("ScoringProject")

  @@index([creePar])
  @@index([clientId])
  @@map("__TABLE_PREFIX___projects")
}

model Scoring {
  id          String   @id @default(uuid())
  projectId   String
  scoreGlobal Float
  grade       String
  composantes Json
  version     Int
  dateCalcul  DateTime @default(now())

  project               Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluationDomainScores EvaluationDomainScore[]
  evaluationAnswers     EvaluationAnswer[]

  @@map("__TABLE_PREFIX___scorings")
}

model AuditLog {
  id            String   @id @default(uuid())
  projectId     String?
  utilisateurId String
  action        String
  details       String
  dateAction    DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([utilisateurId])
  @@index([dateAction])
  @@map("__TABLE_PREFIX___audit_logs")
}

// Legacy scoring tables (being migrated to new model)
model ScoreDomain {
  id              String          @id @default(uuid())
  code            String          @unique
  label           String
  description     String?
  isActive        Boolean         @default(true)
  weight          Float           @default(0.125)
  orderIndex      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  criteria        ScoreCriterion[]
  evaluationDomainScores EvaluationDomainScore[]

  // Migration reference to new model
  migratedToNodeId String?

  @@map("__TABLE_PREFIX___domains")
}

model ScoreCriterion {
  id              String          @id @default(uuid())
  domainId        String
  code            String
  label           String
  description     String?
  type            String          @default("OPTION")
  isActive        Boolean         @default(true)
  hardStopIfBelow Float?
  orderIndex      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  domain          ScoreDomain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  options         ScoreOption[]
  ranges          ScoreRange[]
  evaluationAnswers EvaluationAnswer[]

  // Migration reference to new model
  migratedToNodeId String?

  @@unique([domainId, code])
  @@index([domainId])
  @@map("__TABLE_PREFIX___criteria")
}

model ScoreOption {
  id              String          @id @default(uuid())
  criterionId     String
  label           String
  score           Float
  orderIndex      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  criterion       ScoreCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@map("__TABLE_PREFIX___options")
}

model ScoreRange {
  id              String          @id @default(uuid())
  criterionId     String
  minValue        Float
  maxValue        Float
  score           Float
  label           String?
  orderIndex      Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  criterion       ScoreCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@map("__TABLE_PREFIX___ranges")
}

model Country {
  id              String          @id @default(uuid())
  code            String          @unique
  label           String
  riskScore       Float           @default(50.0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("__TABLE_PREFIX___countries")
}

model SystemConfig {
  id              String          @id @default(uuid())
  key             String          @unique
  value           String
  description     String?
  updatedAt       DateTime        @updatedAt

  @@map("__TABLE_PREFIX___system_config")
}

model EvaluationDomainScore {
  id              String          @id @default(uuid())
  domainId        String
  scoringId       String
  score           Float
  weight          Float
  createdAt       DateTime        @default(now())

  domain          ScoreDomain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  scoring         Scoring         @relation(fields: [scoringId], references: [id], onDelete: Cascade)

  @@unique([domainId, scoringId])
  @@index([domainId])
  @@index([scoringId])
  @@map("__TABLE_PREFIX___evaluation_domain_scores")
}

model EvaluationAnswer {
  id              String          @id @default(uuid())
  criterionId     String
  scoringId       String
  answerType      String          @default("OPTION")
  optionValue     String?
  rangeValue      Float?
  score           Float?
  createdAt       DateTime        @default(now())

  criterion       ScoreCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  scoring         Scoring         @relation(fields: [scoringId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@index([scoringId])
  @@map("__TABLE_PREFIX___evaluation_answers")
}

model Evaluation {
  id                          String              @id @default(uuid())
  projectId                   String
  analystId                   String?
  scoringResult               Json                // ScoringResult object
  stressTestResult            Json?               // StressTestResult object (optional)
  rating                      String              // AAA, AA, A, BBB, BB, B, CCC, D
  finalScore                  Float
  recommendation              String              // APPROVE, APPROVE_WITH_CONDITIONS, REJECT
  probabilityOfDefault        Float
  triggeredNOGOs              Json                // Array of NO-GO rule IDs
  appliedMALUS                Json                // Array of MALUS penalties
  malusTotal                  Float
  notes                       String?
  status                      EvaluationStatus    @default(brouillon)
  version                     String              @default("7.0")
  // Extended fields
  scoreFinancier              Float?
  scoreTechnique              Float?
  scoreMarche                 Float?
  scoreEnvironnemental        Float?
  scoreSocial                 Float?
  scoreGouvenance             Float?
  scoreJuridique              Float?
  scorePays                   Float?
  approvedBy                  String?
  approvedAt                  DateTime?
  rejectedBy                  String?
  rejectedAt                  DateTime?
  rejectionReason             String?
  // Archiving & Versioning
  isArchived                  Boolean             @default(false)
  versionNumber               Int                 @default(1)
  parentEvaluationId          String?             // For version history
  archivedAt                  DateTime?
  archivedBy                  String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  project                     Project             @relation("ProjectEvaluations", fields: [projectId], references: [id], onDelete: Cascade)
  analyst                     User?               @relation("AnalystEvaluations", fields: [analystId], references: [id], onDelete: SetNull)
  stressTestResults           StressTestScenarioResult[]
  auditLogs                   ScoringAuditLog[]
  parentEvaluation            Evaluation?         @relation("EvaluationVersions", fields: [parentEvaluationId], references: [id], onDelete: SetNull)
  versionedEvaluations        Evaluation[]        @relation("EvaluationVersions")

  @@index([projectId])
  @@index([analystId])
  @@index([rating])
  @@index([createdAt])
  @@index([isArchived])
  @@index([parentEvaluationId])
  @@map("__TABLE_PREFIX___v7pp_evaluations")
}

model StressTestScenarioResult {
  id                String              @id @default(uuid())
  evaluationId      String
  scenarioId        String              // REVENUE_DECLINE_10, etc.
  scenarioName      String
  dscrBase          Float
  dscrStress        Float
  llcrStress        Float?
  status            String              // PASS, MARGINAL, FAIL
  margin            Float
  notes             String?
  createdAt         DateTime            @default(now())

  evaluation        Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@map("__TABLE_PREFIX___v7pp_stress_results")
}

model ScoringAuditLog {
  id                String              @id @default(uuid())
  evaluationId      String
  userId            String
  action            String              // CALCULATE, STRESS_TEST, RECALCULATE
  changes           Json?               // What changed
  previousScore     Float?
  newScore          Float?
  timestamp         DateTime            @default(now())

  evaluation        Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  user              User                @relation("ScoringAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([userId])
  @@index([timestamp])
  @@map("__TABLE_PREFIX___v7pp_audit_logs")
}

// ============================================================================
// NEW SCORING GOVERNANCE & PARAMETERIZATION MODEL (V7++.4+)
// ============================================================================

/// ScoringModel represents a family of scoring logic (e.g., PF Standard, PF Renewables)
model ScoringModel {
  id                String   @id @default(uuid())
  code              String   @unique
  label             String
  description       String?
  businessSegment   String?
  projectType       String?
  status            ScoringModelStatus @default(DRAFT)
  isActive          Boolean  @default(true)
  ownerBusinessId   String?
  ownerRiskId       String?
  effectiveDate     DateTime?
  expiryDate        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ownerBusiness     User?    @relation("OwnerBusiness", fields: [ownerBusinessId], references: [id], onDelete: SetNull)
  versions          ScoringModelVersion[]
  evaluations       ScoringEvaluation[] @relation("ModelUsed")
  changeLogs        ScoringChangeLog[]

  @@map("__TABLE_PREFIX___v7pp_scoring_models")
}

/// ScoringModelVersion represents a governed version of a scoring model
model ScoringModelVersion {
  id                String   @id @default(uuid())
  modelId           String
  versionNumber     Int
  label             String
  status            VersionStatus @default(DRAFT)
  isPublished       Boolean  @default(false)
  effectiveDate     DateTime?
  expiryDate        DateTime?
  changeReason      String?
  releaseNotes      String?
  createdBy         String
  validatedBy       String?
  publishedBy       String?
  createdAt         DateTime @default(now())
  validatedAt       DateTime?
  publishedAt       DateTime?
  updatedAt         DateTime @updatedAt

  model             ScoringModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  creator           User     @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  validator         User?    @relation("ValidatedBy", fields: [validatedBy], references: [id], onDelete: SetNull)
  publisher         User?    @relation("PublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)

  nodes             ScoringNode[]
  rules             ScoringNodeRule[]
  calculatedFields  ScoringCalculatedField[]
  evaluations       ScoringEvaluation[] @relation("VersionUsed")
  changeLogs        ScoringChangeLog[]

  @@unique([modelId, versionNumber])
  @@index([modelId])
  @@index([status])
  @@index([isPublished])
  @@map("__TABLE_PREFIX___v7pp_scoring_versions")
}

/// ScoringNode is the universal hierarchical unit representing any level:
/// DOMAIN, CRITERION, SUB_CRITERION, SUB_SUB_CRITERION, GROUP, LEAF, BLOCK
model ScoringNode {
  id                    String   @id @default(uuid())
  versionId             String
  parentNodeId          String?
  nodeType              ScoringNodeType
  code                  String
  label                 String
  shortLabel            String?
  description           String?
  helpText              String?
  displayPath           String?
  depth                 Int
  orderIndex            Int
  isActive              Boolean  @default(true)
  isTerminal            Boolean  @default(false)
  isScored              Boolean  @default(false)
  isMandatory           Boolean  @default(false)
  allowsChildren        Boolean  @default(true)
  weight                Float?
  weightMode            String?  @default("RELATIVE") // RELATIVE, ABSOLUTE, NONE
  aggregationMethod     String?
  answerType            ScoringAnswerType?
  scoringMethod         String?
  scoreMin              Float?
  scoreMax              Float?
  defaultValue          String?
  unit                  String?
  currency              String?
  uiSchemaJson          String?  // JSON string for UI rendering hints
  metadataJson          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  version               ScoringModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parentNode            ScoringNode? @relation("ChildNodes", fields: [parentNodeId], references: [id], onDelete: Cascade)
  childNodes            ScoringNode[] @relation("ChildNodes")

  options               ScoringNodeOption[]
  ranges                ScoringNodeRange[]
  formulas              ScoringNodeFormula[]
  rules                 ScoringNodeRule[]
  applicabilityRules    ScoringNodeApplicabilityRule[]
  documentRequirements  ScoringNodeDocumentRequirement[]
  dataBindings          ScoringNodeDataBinding[]
  evaluationAnswers     ScoringEvaluationAnswer[] @relation("NodeAnswers")
  nodeResults           ScoringEvaluationNodeResult[] @relation("NodeScored")

  @@unique([versionId, code])
  @@index([versionId])
  @@index([parentNodeId])
  @@index([nodeType])
  @@index([isActive])
  @@index([depth])
  @@map("__TABLE_PREFIX___v7pp_scoring_nodes")
}

/// ScoringNodeOption represents a single option/choice for a node
model ScoringNodeOption {
  id                String   @id @default(uuid())
  nodeId            String
  code              String?
  label             String
  value             String?
  score             Float?
  riskLevel         String?
  color             String?
  orderIndex        Int
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  metadataJson      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  node              ScoringNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, code])
  @@index([nodeId])
  @@map("__TABLE_PREFIX___v7pp_scoring_options")
}

/// ScoringNodeRange represents a range/bracket for numeric answers
model ScoringNodeRange {
  id                String   @id @default(uuid())
  nodeId            String
  label             String?
  minValue          Float
  maxValue          Float
  minIncluded       Boolean  @default(true)
  maxIncluded       Boolean  @default(true)
  score             Float?
  color             String?
  orderIndex        Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  node              ScoringNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("__TABLE_PREFIX___v7pp_scoring_ranges")
}

/// ScoringNodeFormula represents a parameterized formula for score calculation
model ScoringNodeFormula {
  id                String   @id @default(uuid())
  nodeId            String
  expression        String   // Mathematical expression with variable references
  variablesJson     String?  // JSON string of allowed variables
  minOutput         Float?
  maxOutput         Float?
  roundingMode      String?  @default("HALF_UP") // HALF_UP, FLOOR, CEIL
  fallbackValue     Float?
  fallbackMessage   String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  node              ScoringNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId])
  @@map("__TABLE_PREFIX___v7pp_scoring_formulas")
}

/// ScoringNodeRule represents business rules (NO-GO, hard stop, malus, warning)
model ScoringNodeRule {
  id                    String   @id @default(uuid())
  nodeId                String?
  versionId             String
  ruleType              RuleType
  code                  String
  label                 String
  description           String?
  conditionExpression   String   // Expression to evaluate
  severity              String   // CRITICAL, HIGH, MEDIUM, LOW, INFO
  actionType            String   // REJECT, BLOCK, APPLY_MALUS, SHOW_WARNING, REQUIRE_APPROVAL, HIDE_NODE, MAKE_REQUIRED
  penaltyValue          Float?
  blocking              Boolean  @default(false)
  messageUser           String?
  messageCommittee      String?
  orderIndex            Int
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  node                  ScoringNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version               ScoringModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([versionId])
  @@index([ruleType])
  @@map("__TABLE_PREFIX___v7pp_scoring_rules")
}

/// ScoringNodeApplicabilityRule determines if a node should be shown/required/hidden
model ScoringNodeApplicabilityRule {
  id                    String   @id @default(uuid())
  nodeId                String
  conditionExpression   String   // Expression based on project/evaluation context
  effectType            String   // SHOW, HIDE, REQUIRE, OPTIONAL, READ_ONLY, EXCLUDE_FROM_SCORE
  priority              Int      @default(100)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  node                  ScoringNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("__TABLE_PREFIX___v7pp_applicability_rules")
}

/// ScoringNodeDocumentRequirement specifies documents expected for a node
model ScoringNodeDocumentRequirement {
  id                    String   @id @default(uuid())
  nodeId                String
  documentType          String
  label                 String
  description           String?
  isRequired            Boolean  @default(false)
  allowedMimeTypes      String?  // Comma-separated or JSON
  maxFileSizeMb         Int?
  validationLevel       String?  @default("INFORMATIVE") // INFORMATIVE, WARNING, BLOCKING
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  node                  ScoringNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("__TABLE_PREFIX___v7pp_document_requirements")
}

// ============================================================================
// SCORING EVALUATION (NEW MODEL)
// ============================================================================

/// ScoringEvaluation represents the evaluation of a project using a specific model version
model ScoringEvaluation {
  id                    String   @id @default(uuid())
  projectId             String
  clientId              String?
  modelId               String
  modelVersionId        String
  analystId             String
  status                EvaluationStatus @default(brouillon)
  finalScore            Float?
  rating                String?
  recommendation        String?
  probabilityOfDefault  Float?
  malusTotal            Float?   @default(0)
  triggeredRulesJson    String?  // JSON array of triggered rule IDs
  summaryJson           String?  // JSON summary of key scores
  notes                 String?
  submittedAt           DateTime?
  validatedAt           DateTime?
  approvedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project               Project  @relation("ScoringProject", fields: [projectId], references: [id], onDelete: Cascade)
  client                Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  model                 ScoringModel @relation("ModelUsed", fields: [modelId], references: [id], onDelete: SetNull)
  version               ScoringModelVersion @relation("VersionUsed", fields: [modelVersionId], references: [id], onDelete: SetNull)
  analyst               User     @relation("ScoringAnalyst", fields: [analystId], references: [id], onDelete: SetNull)

  answers               ScoringEvaluationAnswer[]
  nodeResults           ScoringEvaluationNodeResult[]
  changeLogs            ScoringChangeLog[]

  @@index([projectId])
  @@index([clientId])
  @@index([modelId])
  @@index([modelVersionId])
  @@index([analystId])
  @@index([status])
  @@map("__TABLE_PREFIX___v7pp_scoring_evaluations")
}

/// ScoringEvaluationAnswer represents an answer provided by the user for a node
model ScoringEvaluationAnswer {
  id                      String   @id @default(uuid())
  evaluationId            String
  nodeId                  String
  answerType              ScoringAnswerType
  valueString             String?
  valueNumber             Float?
  valueBoolean            Boolean?
  valueDate               DateTime?
  valueJson               String?  // For complex types
  manualScore             Float?
  comment                 String?
  sourceDocumentId        String?

  // Source tracking fields used to link Client / Project / Scoring
  sourceType              String?  // AUTO, MANUAL, CALCULATED, OVERRIDE, FALLBACK
  sourceEntity            String?  // CLIENT, PROJECT, EVALUATION, CALCULATED, EXTERNAL_REFERENCE
  sourceField             String?
  sourcePath              String?
  sourceBindingId         String?
  sourceValueSnapshotJson String?
  resolvedValueSnapshotJson String?
  isAutoFilled            Boolean  @default(false)
  isOverridden            Boolean  @default(false)
  overrideReason          String?
  overriddenBy            String?
  overriddenAt            DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  evaluation              ScoringEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  node                    ScoringNode @relation("NodeAnswers", fields: [nodeId], references: [id], onDelete: Cascade)
  sourceBinding           ScoringNodeDataBinding? @relation(fields: [sourceBindingId], references: [id], onDelete: SetNull)

  @@unique([evaluationId, nodeId])
  @@index([evaluationId])
  @@index([nodeId])
  @@index([sourceBindingId])
  @@map("__TABLE_PREFIX___v7pp_evaluation_answers")
}

/// ScoringEvaluationNodeResult represents the calculated score for a node
model ScoringEvaluationNodeResult {
  id                    String   @id @default(uuid())
  evaluationId          String
  nodeId                String
  rawScore              Float?
  weightedScore         Float?
  normalizedScore       Float?
  aggregationMethod     String?
  ruleImpactJson        String?  // JSON of rules that affected this node
  explanation           String?
  traceJson             String?  // Detailed calculation trace
  createdAt             DateTime @default(now())

  evaluation            ScoringEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  node                  ScoringNode @relation("NodeScored", fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, nodeId])
  @@index([evaluationId])
  @@index([nodeId])
  @@map("__TABLE_PREFIX___v7pp_evaluation_node_results")
}

// ============================================================================
// AUDIT & CHANGE LOG
// ============================================================================

/// ScoringChangeLog tracks all changes to scoring configuration
model ScoringChangeLog {
  id                    String   @id @default(uuid())
  entityType            String   // ScoringModel, ScoringNode, ScoringNodeRule, etc.
  entityId              String
  modelId               String?
  versionId             String?
  evaluationId          String?
  action                String   // CREATE, UPDATE, DELETE, PUBLISH, VALIDATE, etc.
  fieldName             String?  // Which field changed (for UPDATE)
  oldValueJson          String?  // Previous value as JSON
  newValueJson          String?  // New value as JSON
  changedBy             String
  changedAt             DateTime @default(now())
  comment               String?

  model                 ScoringModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  version               ScoringModelVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  evaluation            ScoringEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  user                  User     @relation("ChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([entityId])
  @@index([modelId])
  @@index([versionId])
  @@index([evaluationId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("__TABLE_PREFIX___v7pp_change_logs")
}


// ============================================================================
// CLIENT / PROJECT / SCORING BINDING MODELS
// ============================================================================

/// ScoringNodeDataBinding defines how a scoring node retrieves data from Client,
/// Project, Evaluation context, calculated fields, or a manual-only source.
model ScoringNodeDataBinding {
  id                      String   @id @default(uuid())
  nodeId                  String
  sourceEntity            String   // CLIENT, PROJECT, EVALUATION, DOCUMENT, CALCULATED, EXTERNAL_REFERENCE, MANUAL
  sourceField             String?
  sourcePath              String?
  bindingMode             String   // AUTO_READONLY, AUTO_EDITABLE, AUTO_IF_EMPTY, MANUAL_ONLY, CALCULATED_ONLY
  dataType                String   // STRING, NUMBER, BOOLEAN, DATE, JSON, PERCENTAGE, CURRENCY
  transformType           String   @default("NONE")
  transformConfigJson     String?
  defaultValueString      String?
  defaultValueNumber      Float?
  defaultValueBoolean     Boolean?
  fallbackValueString     String?
  fallbackValueNumber     Float?
  fallbackValueBoolean    Boolean?
  isRequired              Boolean  @default(false)
  isReadOnly              Boolean  @default(false)
  allowOverride           Boolean  @default(false)
  overrideRequiresReason  Boolean  @default(false)
  priority                Int      @default(1)
  isActive                Boolean  @default(true)
  description             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  node                    ScoringNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  evaluationAnswers       ScoringEvaluationAnswer[]

  @@index([nodeId])
  @@index([nodeId, priority])
  @@index([sourceEntity])
  @@map("__TABLE_PREFIX___v7pp_scoring_node_bindings")
}

/// ScoringDataFieldRegistry lists the fields that admins are allowed to bind.
/// It helps avoid invalid source paths in the scoring designer.
model ScoringDataFieldRegistry {
  id                      String   @id @default(uuid())
  entityType              String   // CLIENT, PROJECT, EVALUATION, CALCULATED
  fieldCode               String
  fieldPath               String
  label                   String
  dataType                String
  description             String?
  isBindable              Boolean  @default(true)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([entityType, fieldCode])
  @@index([entityType])
  @@index([isActive])
  @@map("__TABLE_PREFIX___v7pp_scoring_field_registry")
}

/// ScoringCalculatedField stores reusable calculated expressions at model version level.
model ScoringCalculatedField {
  id                      String   @id @default(uuid())
  versionId               String
  code                    String
  label                   String
  expression              String
  variablesJson           String?
  outputType              String
  description             String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  version                 ScoringModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, code])
  @@index([versionId])
  @@map("__TABLE_PREFIX___v7pp_scoring_calculated_fields")
}

